  lines:
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 703dc7b93cc9c6044941c991be9b8cb5,
      type: 3}
    dialogueText: The recorder is still running. Looks like there were residents
      here not long ago. Where did they go?
  - characterName: Little Ghost
    characterPortrait: {fileID: 21300000, guid: 4064d2c433ff4b84b93308dcba9b07d6,
      type: 3}
    dialogueText: "They, they... changed form. They\u2019re no longer villagers.
      You\u2019ll meet them."
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 703dc7b93cc9c6044941c991be9b8cb5,
      type: 3}
    dialogueText: "Alright, I\u2019ll look for more clues."
