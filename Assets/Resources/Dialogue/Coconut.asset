MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e0ed3463f6034dc6a0ff0b0d4ab7118e, type: 3}
  m_Name: Coconut
  m_EditorClassIdentifier: 
  lines:
  - characterName: 
    characterPortrait: {fileID: 21300000, guid: 2ca377380de845c4382475b8f67fb736,
      type: 3}
    dialogueText: "You\u2019ve obtained a mysterious black stone hidden inside a
      coconut."
  - characterName: 
    characterPortrait: {fileID: 21300000, guid: 2ca377380de845c4382475b8f67fb736,
      type: 3}
    dialogueText: "Hint: It seems to contain supernatural power. It\u2019s recommended
      to store it safely and avoid being affected."
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 703dc7b93cc9c6044941c991be9b8cb5,
      type: 3}
    dialogueText: What is this stone?
  - characterName: Little Ghost
    characterPortrait: {fileID: 21300000, guid: 4064d2c433ff4b84b93308dcba9b07d6,
      type: 3}
    dialogueText: "This is what you\u2019re looking for. You can leave now."
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 703dc7b93cc9c6044941c991be9b8cb5,
      type: 3}
    dialogueText: "No, I\u2019m really curious about this place. I\u2019ll uncover
      the truth."
  - characterName: Little Ghost
    characterPortrait: {fileID: 21300000, guid: 4064d2c433ff4b84b93308dcba9b07d6,
      type: 3}
    dialogueText: "You should leave soon. I don\u2019t want you to turn into..."
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 703dc7b93cc9c6044941c991be9b8cb5,
      type: 3}
    dialogueText: "Don\u2019t worry! I\u2019m a strong investigator! I\u2019ll uncover
      the truth soon."
  - characterName: Little Ghost
    characterPortrait: {fileID: 21300000, guid: 4064d2c433ff4b84b93308dcba9b07d6,
      type: 3}
    dialogueText: I can show you around the village.
