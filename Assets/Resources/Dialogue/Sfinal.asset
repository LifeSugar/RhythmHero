  m_Script: {fileID: 11500000, guid: e0ed3463f6034dc6a0ff0b0d4ab7118e, type: 3}
  m_Name: Sfinal
  m_EditorClassIdentifier: 
  lines:
  - characterName: Little Ghost
    characterPortrait: {fileID: 21300000, guid: 4064d2c433ff4b84b93308dcba9b07d6,
      type: 3}
    dialogueText: "They\u2019re great singers. If you listen patiently, you might
      find some clues."
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 703dc7b93cc9c6044941c991be9b8cb5,
      type: 3}
    dialogueText: "I\u2019ll give it a try!"
  - characterName: Little Ghost
    characterPortrait: {fileID: 21300000, guid: 4064d2c433ff4b84b93308dcba9b07d6,
      type: 3}
    dialogueText: "I\u2019ll conduct them. You pick the right members. Remember!
      Be careful! Your choices will lead to clues!"
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 703dc7b93cc9c6044941c991be9b8cb5,
      type: 3}
    dialogueText: "Then I\u2019ll choose a tune I can understand."
  - characterName: Little Ghost
    characterPortrait: {fileID: 21300000, guid: 4064d2c433ff4b84b93308dcba9b07d6,
      type: 3}
    dialogueText: Exactly! Be sure to find the tune you can understand!
