%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 0}
  m_Name: NewDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Ghost
    characterPortrait: {fileID: 21300000, guid: 4064d2c433ff4b84b93308dcba9b07d6,
      type: 3}
    dialogueText: " \u201CThe exit\u2019s around this area. But\u2026 there\u2019s
      a bit of a problem.\u201D"
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: f1626c2b086030d498fbee7a5da51299,
      type: 3}
    dialogueText: "\u201CLooks like we\u2019re finally getting close to the exit.\u201D"
  - characterName: you
    characterPortrait: {fileID: 21300000, guid: f1626c2b086030d498fbee7a5da51299,
      type: 3}
    dialogueText: "\u201CIt\u2019s so noisy here.\u201D"
  - characterName: Ghost
    characterPortrait: {fileID: 21300000, guid: 4064d2c433ff4b84b93308dcba9b07d6,
      type: 3}
    dialogueText: "\u201CLook, there are a bunch of little creatures all around!
      We need to find the ones that match this world\u2019s rhythm perfectly. Only
      by performing a flawless ensemble will this city be satisfied.\u201D"
  - characterName: Ghost
    characterPortrait: {fileID: 21300000, guid: 4064d2c433ff4b84b93308dcba9b07d6,
      type: 3}
    dialogueText: "\u201CI can conduct them, but\u2026\u201D"
  - characterName: you
    characterPortrait: {fileID: 21300000, guid: f1626c2b086030d498fbee7a5da51299,
      type: 3}
    dialogueText: " \u201CBut what?\u201D"
  - characterName: Ghost
    characterPortrait: {fileID: 21300000, guid: 4064d2c433ff4b84b93308dcba9b07d6,
      type: 3}
    dialogueText: "\u201CI don\u2019t have any sense of rhythm at all. Boo hoo\u2026
      can you teach me how to pick the right accompanists?\u201D"
  - characterName: Ghost
    characterPortrait: {fileID: 21300000, guid: 4064d2c433ff4b84b93308dcba9b07d6,
      type: 3}
    dialogueText: "\u201CIt might be tough, but we can listen to them before deciding
      who to recruit!\u201D"
  - characterName: you
    characterPortrait: {fileID: 21300000, guid: f1626c2b086030d498fbee7a5da51299,
      type: 3}
    dialogueText: "\u201CUgh, it\u2019s so loud. Let\u2019s mute these little critters
      first!\u201D"
